# Modèle de configuration. Copier en « .env » et remplir (jamais dans le dépôt).
# Sur le serveur, le script d'installation crée ce fichier lui-même.

# Base de données (générée par l'installation)
DATABASE_URL=

# Espace administrateur
ADMIN_EMAIL=
# Empreinte Argon2 du mot de passe admin (générée par l'installation, jamais le mot de passe en clair)
ADMIN_PASSWORD_HASH=
# Clé de signature des sessions (générée par l'installation)
SESSION_SECRET=

# API Légifrance (PISTE), identifiants OAuth de VOTRE application PISTE (compte personnel et gratuit)
# Marche à suivre : docs/configuration-piste.md ; vérification : npm run verifier:piste
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# Mesure d'audience (Umami) : remplis par deploy/installer-stats.sh
UMAMI_WEBSITE_ID=
UMAMI_SITE_UTILISATEUR=
UMAMI_SITE_MDP=

# Adresse publique du site
SITE_URL=https://exemple.org
